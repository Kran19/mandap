datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum SubscriptionStatus {
  PENDING_AUTHORIZATION
  TRIALING
  ACTIVE
  PAST_DUE
  RESTRICTED
  CANCELLED
  EXPIRED
}

enum TrialStatus {
  REQUESTED
  ESTABLISHED
  CANCELLED
  CONVERTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
  OPERATIONS
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

// ------------------------------------------------------
// Models
// ------------------------------------------------------

model User {
  id                 String     @id @default(uuid())
  email              String?    @unique
  passwordHash       String
  firstName          String?
  lastName           String?
  phone              String?    @unique
  gender             String?
  aadhaarNumber      String?
  aadhaarFrontUrl    String?
  aadhaarBackUrl     String?
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  mobileVerifiedAt   DateTime?
  identityVerifiedAt DateTime?
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations   OrganizationMember[]
  adminMembership AdminMembership?
  refreshSessions RefreshSession[]
  order           Order[]
  trialSetups     TrialSetup[]
  trialClaims     TrialClaim[]
}

model Organization {
  id     String             @id @default(uuid())
  name   String
  slug   String             @unique
  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  projects      Project[]
  subscriptions Subscription[]
  orders        Order[]
  payments      Payment[]
  usages        UsageMetric[]
  trialSetups   TrialSetup[]
  trialClaims   TrialClaim[]
}

model OrganizationMember {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Plan {
  id                    String  @id @default(uuid())
  name                  String
  slug                  String  @unique
  description           String?
  monthlyPrice          Decimal @db.Decimal(12, 2)
  yearlyPrice           Decimal @db.Decimal(12, 2)
  currency              String  @default("INR")
  status                String  @default("ACTIVE")
  monthlyProviderPlanId String?
  yearlyProviderPlanId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features      PlanFeature[]
  limits        PlanLimit[]
  subscriptions Subscription[]
  trialSetups   TrialSetup[]
  trialClaims   TrialClaim[]
}

model PlanFeature {
  id         String  @id @default(uuid())
  planId     String
  featureKey String
  enabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model PlanLimit {
  id     String @id @default(uuid())
  planId String
  key    String
  value  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Project {
  id               String        @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  status           ProjectStatus @default(ACTIVE)
  currentVersionId String?
  createdBy        String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     ProjectVersion[]
}

model ProjectVersion {
  id            String  @id @default(uuid())
  projectId     String
  versionNumber Int
  layoutData    Json?
  metadata      Json?
  createdBy     String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([projectId, createdAt])
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String
  planId                 String
  provider               String
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus @default(TRIALING)
  billingStatus          String?
  accessStatus           String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  gracePeriodEndsAt  DateTime?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  events       SubscriptionEvent[]
  trialClaim   TrialClaim?
}

model SubscriptionEvent {
  id             String  @id @default(uuid())
  subscriptionId String
  eventType      String
  previousStatus String?
  newStatus      String?
  metadata       Json?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(uuid())
  organizationId  String
  userId          String?
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  currency        String      @default("INR")
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  provider        String?
  providerOrderId String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  payments     Payment[]
  user         User?        @relation(fields: [userId], references: [id])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  description String
  quantity    Int
  unitAmount  Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  metadata    Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  orderId           String
  provider          String
  providerPaymentId String?       @unique
  providerOrderId   String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  paidAt            DateTime?
  failureCode       String?
  failureMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds      Refund[]
}

model Refund {
  id               String  @id @default(uuid())
  paymentId        String
  providerRefundId String? @unique
  amount           Decimal @db.Decimal(12, 2)
  currency         String  @default("INR")
  status           String  @default("PENDING")
  reason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model WebhookEvent {
  id            String    @id @default(uuid())
  provider      String
  eventId       String
  eventType     String
  payloadHash   String
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  lastAttemptAt DateTime?
  lastError     String?

  @@unique([provider, eventId])
}

model UsageMetric {
  id             String    @id @default(uuid())
  organizationId String
  metric         String
  value          Int
  periodStart    DateTime?
  periodEnd      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AdminMembership {
  id       String  @id @default(uuid())
  userId   String  @unique
  roleId   String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRoleModel @relation(fields: [roleId], references: [id], onDelete: Restrict)
}

model AdminRoleModel {
  id          String    @id @default(uuid())
  name        AdminRole @unique
  description String?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions AdminPermission[]
  memberships AdminMembership[]
}

model AdminPermission {
  id     String @id @default(uuid())
  roleId String
  action String

  createdAt DateTime @default(now())

  role AdminRoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action])
}

model AuditLog {
  id             String  @id @default(uuid())
  adminId        String?
  actorUserId    String?
  organizationId String?
  action         String
  resourceType   String
  resourceId     String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([actorUserId])
  @@index([organizationId])
  @@index([resourceType])
  @@index([resourceId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?
  enabled     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  replacedBy String?   @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model IdempotencyRecord {
  id             String @id @default(uuid())
  organizationId String
  userId         String
  endpoint       String
  idempotencyKey String
  requestHash    String
  status         String @default("PENDING") // PENDING, COMPLETED
  responseStatus Int?
  responseBody   Json?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([organizationId, userId, endpoint, idempotencyKey])
  @@index([expiresAt])
}

model TrialSetup {
  id             String @id @default(uuid())
  userId         String
  organizationId String
  planId         String

  emailNormalizedHash   String?
  mobileNormalizedHash  String?
  identityReferenceHash String?

  providerSubscriptionId String? @unique

  status String @default("PENDING") // PENDING, COMPLETED, ABANDONED, EXPIRED

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model TrialClaim {
  id String @id @default(uuid())

  userId         String
  organizationId String
  trialPlanId    String

  subscriptionId String? @unique

  emailNormalizedHash   String? @unique
  mobileNormalizedHash  String? @unique
  identityReferenceHash String? @unique
  paymentFingerprint    String? @unique

  status TrialStatus @default(ESTABLISHED)

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  endsAt      DateTime?
  consumedAt  DateTime?
  cancelledAt DateTime?
  abandonedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan          @relation(fields: [trialPlanId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}
